# Sanity write token (Editor or higher) — required for import
# Create at: https://www.sanity.io/manage → Project → API → Tokens
SANITY_API_WRITE_TOKEN=

# Optional overrides (defaults match sanity.config.ts)
# SANITY_STUDIO_PROJECT_ID=rhq335ze
# SANITY_STUDIO_DATASET=production

# Optional: path to extracted O*NET text folder
# ONET_DATA_DIR=./data/onet-31.0/db_31_0_text

# Interview coaching Knowledge Base (npm run kb:coaching)
# The token above (or your `sanity login` user) must be able to create knowledge bases in the
# organization and have the Administrator or Developer role on the project.
SANITY_ORGANIZATION_ID=opj96zyhx
# Printed by the first `npm run kb:coaching` run. Set it so later runs reuse the same knowledge base.
# COACHING_KB_ID=
