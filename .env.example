# Sanity write token (Editor or higher) — required for import
# Create at: https://www.sanity.io/manage → Project → API → Tokens
SANITY_API_WRITE_TOKEN=

# Optional overrides (defaults match sanity.config.ts)
# SANITY_STUDIO_PROJECT_ID=rhq335ze
# SANITY_STUDIO_DATASET=production

# Optional: path to extracted O*NET text folder
# ONET_DATA_DIR=./data/onet-31.0/db_31_0_text

# Conversation Insights classifier (read by sanity.blueprint.ts at deploy time)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
SANITY_ORGANIZATION_ID=opj96zyhx
SANITY_CONTEXT_ENDPOINT_NAME=career-explorer
# Editor token: npx sanity tokens add "Sanity Context Insights" --role=editor --yes --json --project-id=rhq335ze
SANITY_INSIGHTS_TOKEN=
